#!/command/with-contenv bashio
# ==============================================================================
# Maintenance Window — s6 service "finish" script
#
# Runs when the service exits. $1 is the exit code of the run script, $2 is the
# signal number (if killed). Log the reason, then let s6 keep managing the
# long-running service. Halting the whole container here makes benign service
# stops look like add-on restarts in Supervisor logs.
# ==============================================================================
# shellcheck shell=bash

declare exit_code="${1:-0}"
declare signal_number="${2:-0}"

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "Maintenance Window service exited with code ${exit_code}"
else
    bashio::log.info "Maintenance Window service exited with code ${exit_code}, signal ${signal_number}"
fi

exit 0
