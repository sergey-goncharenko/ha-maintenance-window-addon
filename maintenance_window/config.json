{
  "name": "Maintenance Window",
  "version": "0.1.1",
  "slug": "maintenance_window",
  "description": "Scheduled quiet mode: stop Home Assistant Core (and optionally selected add-ons) for a short maintenance window, then restart automatically.",
  "url": "https://github.com/sergey-goncharenko/ha-maintenance-window-addon/tree/main/maintenance_window",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "init": false,
  "startup": "services",
  "boot": "auto",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": false,
  "map": [
    "addon_config:rw"
  ],
  "options": {
    "log_level": "info",
    "dry_run": false,
    "restart_core": true,
    "stop_addons": [],
    "windows": [
      {
        "name": "Nightly maintenance",
        "start_time": "03:00",
        "duration_minutes": 10,
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      }
    ]
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
    "dry_run": "bool",
    "restart_core": "bool",
    "stop_addons": [
      "str"
    ],
    "windows": [
      {
        "name": "str",
        "start_time": "match(^([01]?[0-9]|2[0-3]):[0-5][0-9]$)",
        "duration_minutes": "int(1,1440)",
        "days": [
          "list(mon|tue|wed|thu|fri|sat|sun)"
        ]
      }
    ]
  }
}
