{
  "name": "Maintenance Window",
  "version": "0.9.0",
  "slug": "maintenance_window",
  "description": "Scheduled quiet mode: stop Home Assistant Core (and optionally selected apps) for a short maintenance window, then restart automatically.",
  "url": "https://github.com/sergey-goncharenko/ha-maintenance-window-addon/tree/main/maintenance_window",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "image": "ghcr.io/sergey-goncharenko/maintenance-window-addon",
  "init": false,
  "startup": "services",
  "boot": "auto",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "map": [
    "addon_config:rw"
  ],
  "options": {
    "log_level": "info",
    "dry_run": true,
    "restart_core": false,
    "core_stop_confirmation": "",
    "startup_grace_seconds": 300,
    "max_core_stop_minutes": 60,
    "core_start_timeout_seconds": 600,
    "restore_stagger_seconds": 15,
    "pause_core_watchdog": true,
    "list_addons_on_startup": true,
    "stop_addons": [],
    "start_addons": [],
    "windows": [
      {
        "name": "Nightly maintenance",
        "start_time": "03:00",
        "duration_minutes": 10,
        "restart_core": false,
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      }
    ]
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
    "dry_run": "bool",
    "restart_core": "bool",
    "core_stop_confirmation": "str",
    "startup_grace_seconds": "int(0,86400)",
    "max_core_stop_minutes": "int(1,1440)",
    "core_start_timeout_seconds": "int(0,3600)",
    "restore_stagger_seconds": "int(0,300)",
    "pause_core_watchdog": "bool",
    "list_addons_on_startup": "bool",
    "stop_addons": [
      "str"
    ],
    "start_addons": [
      "str"
    ],
    "windows": [
      {
        "name": "str",
        "start_time": "match(^([01]?[0-9]|2[0-3]):[0-5][0-9]$)",
        "duration_minutes": "int(1,1440)",
        "restart_core": "bool?",
        "stop_addons": [
          "str?"
        ],
        "start_addons": [
          "str?"
        ],
        "days": [
          "list(mon|tue|wed|thu|fri|sat|sun)?"
        ]
      }
    ]
  }
}
